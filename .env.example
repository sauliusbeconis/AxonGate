# Public origin used in discovery documents and x402 resource URLs.
AXONGATE_PUBLIC_BASE_URL=https://api.axongate.one
AXONGATE_GITHUB_REPO_URL=https://github.com/sauliusbeconis/AxonGate
AXONGATE_CONTACT_EMAIL=hello@axongate.one

# Payments. payTo defaults to the public AxonGate vault.
AXONGATE_VAULT_ADDRESS=0xcD11393c8505C5A44F8b998E0c96BcC5698d76A7
# With CDP keys set, settlement goes through the Coinbase facilitator (required for Bazaar).
# Without them it falls back to PayAI. Force one with AXONGATE_FACILITATOR=cdp|payai.
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret
# Only needed by scripts/paid_smoke.py (signs with a CDP server account).
CDP_WALLET_SECRET=your_cdp_wallet_secret
AXONGATE_X402_ENABLED=true

# Prices in USDC.
AXONGATE_PRICE_READ_USDC=0.002
AXONGATE_PRICE_SEARCH_USDC=0.004
AXONGATE_PRICE_SCAN_USDC=0.002
AXONGATE_PRICE_ANSWER_USDC=0.015
AXONGATE_PRICE_VERIFY_USDC=0.02

# Suppliers. Jina powers search and the rendered-page fallback; the LLM powers answer/verify.
JINA_API_KEY=your_jina_api_key
AXONGATE_LLM_API_KEY=your_openai_api_key
AXONGATE_LLM_MODEL=gpt-5-mini
AXONGATE_LLM_TIMEOUT_SECONDS=40

# Storage, limits, operator access.
REDIS_URL=
AXONGATE_REDIS_MAX_CONNECTIONS=16
AXONGATE_CACHE_TTL_SECONDS=3600
AXONGATE_RATE_LIMIT_PER_MINUTE=120
AXONGATE_PAID_CONCURRENCY=24
AXONGATE_OPERATOR_TOKEN=

# Extra EVM networks accepted besides Base (CDP facilitator only). Same payTo as Base.
AXONGATE_EXTRA_NETWORKS=polygon,arbitrum
# Solana payTo (CDP facilitator only). It must already hold a USDC token account.
AXONGATE_SOLANA_PAY_TO=
