      "USDC": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
    }
  },
  "unit_economics": {
    "base_fee_usdc": 0.02,
    "cost_per_request": 0.02,
    "currency": "USDC",
    "pricing_model": "pay-per-use",
    "recommended_tier": "fresh",
    "dynamic_margin_protection": true,
    "minimum_margin_usdc": 0.01,
    "upstream_cost_usdc": 0.0005,
    "supply_protection": {
      "dns_ssrf_protection": true,
      "target_preflight": true,
      "bad_supply_retry_credits": false,
      "redis_rate_limits": true
    },
    "gas_pricing": {
      "base_fee": "live Base RPC",
      "eth_usdc": "Coinbase spot price with Redis cache",
      "price_floor_usdc": 3500,
      "static_fallback_default": false
    },
    "tiers": {
      "starter": {
        "price_usdc": 0.012,
        "cache_policy": "starter sample or cache-only",
        "recommended_for": "first paid conversion on the sample target or existing cache"
      },
      "cached": {
        "price_usdc": 0.015,
        "cache_policy": "cache-only",
        "recommended_for": "low-cost repeat reads when AxonGate already has a cached copy"
      },
      "basic": {
        "price_usdc": 0.02,
        "cache_policy": "cached",
        "recommended_for": "cache-friendly high-volume requests"
      },
      "fresh": {
        "price_usdc": 0.03,
        "cache_policy": "bypass",
        "recommended_for": "production agent calls that need current public web context"
      },
      "deep": {
        "price_usdc": 0.05,
        "cache_policy": "short-cache",
        "recommended_for": "higher-value requests where margin and freshness matter"
      }
    },
    "proof_packs": {
      "quick": {
        "price_usdc": 0.1,
        "recommended_for": "low-friction citation report trials and cached source reads"
      },
      "standard": {
        "price_usdc": 0.25,
        "recommended_for": "agent builders who need cited evidence reports for a single public source"
      },
      "deep": {
        "price_usdc": 1.0,
        "recommended_for": "higher-value evidence reports with deeper extraction and fresh-by-default source material"
      }
    }
  },
