  "openapi_contract": {
    "method": "POST",
    "path": "/v1/x402/access",
    "docs": "https://api.axongate.one/docs",
    "openapi": "https://api.axongate.one/openapi.json",
    "payload_schema": {
      "target_url": "string (valid HTTP/HTTPS URL)",
      "tier": "optional string (starter, cached, basic, fresh, or deep)",
      "force_refresh": "optional boolean"
    },
    "required_headers": [
      "PAYMENT-SIGNATURE"
    ],
    "retry_headers": [
      "X-AxonGate-Retry-Credit"
    ],
    "success_response": {
      "status": "success",
      "target_url": "string",
      "markdown": "string",
      "payment": "object",
      "ueg_receipt": "object"
    },
    "request_examples": [
      {
        "target_url": "https://www.iana.org/domains/reserved",
        "tier": "starter",
        "force_refresh": false
      },
      {
        "target_url": "https://example.com/source",
        "tier": "cached",
        "force_refresh": false
      },
      {
        "target_url": "https://example.com/source",
        "tier": "basic",
        "force_refresh": false
      },
      {
        "target_url": "https://example.com/breaking-news",
        "tier": "fresh",
        "force_refresh": true
      }
    ],
    "response_format": "application/json",
    "error_statuses": {
      "400": "Invalid URL, invalid payment hash, failed payment verification, replayed payment, or UEG rejection",
      "402": "Missing or invalid x402 payment",
      "503": "Temporary upstream, CDP, or Base RPC outage. Retryable post-payment outages may include X-AxonGate-Retry-Credit for /v1/x402/retry."
    }
  },
  "proof_pack_contract": {
    "method": "POST",
    "path": "/v1/x402/proof-pack",
    "docs": "https://api.axongate.one/proof-pack",
    "sample": "https://api.axongate.one/proof-pack/sample",
    "sample_api": "https://api.axongate.one/v1/proof-pack/sample",
    "quote": "https://api.axongate.one/proof-pack/quote",
    "quote_api": "https://api.axongate.one/v1/proof-pack/quote",
    "request": "https://api.axongate.one/proof-pack/request",
    "lead_api": "https://api.axongate.one/v1/proof-pack/leads",
    "payload_schema": {
      "target_url": "string (valid HTTP/HTTPS URL)",
      "question": "optional string",
      "pack": "optional string (quick, standard, or deep)",
      "force_refresh": "optional boolean"
    },
    "required_headers": [
      "PAYMENT-SIGNATURE"
    ],
    "pack_selector": "Use ?pack= or X-AxonGate-Pack so x402 challenge pricing matches the requested pack.",
    "success_response": {
      "status": "success",
      "target_url": "string",
      "question": "string",
      "pack": "string",
      "answer": "string",
      "executive_summary": "string",
      "confidence_score": "number",
      "key_claims": "array",
      "citations": "array",
      "risks": "array",
      "source_profile": "object",
      "payment": "object",
      "ueg_receipt": "object"
    },
    "packs": {
      "quick": {
        "price_usdc": 0.1,
        "amount_units": "100000"
      },
      "standard": {
        "price_usdc": 0.25,
        "amount_units": "250000"
      },
      "deep": {
        "price_usdc": 1.0,
        "amount_units": "1000000"
      }
    }
  },
