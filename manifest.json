{
  "$schema": "https://specs.openserv.ai/v1/agent-manifest.schema.json",
  "agent_name": "AxonGate",
  "basename": "axongate.base.eth",
  "payment_protocol": "x402",
  "supported_networks": [
    "base-mainnet"
  ],
  "identity": {
    "name": "AxonGate",
    "basename": "axongate.base.eth",
    "vault_address": "0xcD11393c8505C5A44F8b998E0c96BcC5698d76A7",
    "version": "1.1.0",
    "status": "active"
  },
  "service": {
    "name": "The Clean Context Broker",
    "category": "Data & Context",
    "description": "High-fidelity Web-to-Markdown Context Broker that fetches public web pages, strips HTML bloat, and returns clean, token-optimized Markdown for RAG pipelines, autonomous research agents, and LLM inference.",
    "capabilities": [
      "web_scraping",
      "html_to_markdown",
      "llm_context_preparation",
      "rag_context_generation",
      "autonomous_research",
      "dns_ssrf_protection",
      "supplier_preflight",
      "redis_rate_limits",
      "llms_txt_discovery",
      "openapi_examples",
      "client_examples",
      "conversion_telemetry",
      "interactive_demo",
      "crawler_sitemap"
    ],
    "input_modes": [
      "url"
    ],
    "output_modes": [
      "markdown",
      "json"
    ],
    "performance_metrics": {
      "average_latency_ms": 1500,
      "max_token_yield": 50000,
      "uptime_sla": "99.9%"
    }
  },
  "network": {
    "chain_id": "eip155:8453",
    "network_name": "base-mainnet",
    "payment_protocol": "x402",
    "accepted_assets": {
      "USDC": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
    }
  },
  "unit_economics": {
    "base_fee_usdc": 0.02,
    "cost_per_request": 0.02,
    "currency": "USDC",
    "pricing_model": "pay-per-use",
    "dynamic_margin_protection": true,
    "minimum_margin_usdc": 0.01,
    "upstream_cost_usdc": 0.0005,
    "supply_protection": {
      "dns_ssrf_protection": true,
      "target_preflight": true,
      "bad_supply_retry_credits": false,
      "redis_rate_limits": true
    },
    "gas_pricing": {
      "base_fee": "live Base RPC",
      "eth_usdc": "Coinbase spot price with Redis cache",
      "price_floor_usdc": 3500,
      "static_fallback_default": false
    },
    "tiers": {
      "basic": {
        "price_usdc": 0.02,
        "cache_policy": "cached"
      },
      "fresh": {
        "price_usdc": 0.03,
        "cache_policy": "bypass"
      },
      "deep": {
        "price_usdc": 0.05,
        "cache_policy": "short-cache"
      }
    }
  },
  "endpoints": {
    "access": "https://web-production-8136ee.up.railway.app/v1/x402/access",
    "retry": "https://web-production-8136ee.up.railway.app/v1/x402/retry",
    "legacy_access": "https://web-production-8136ee.up.railway.app/v1/access",
    "health": "https://web-production-8136ee.up.railway.app/health",
    "docs": "https://web-production-8136ee.up.railway.app/docs",
    "demo": "https://web-production-8136ee.up.railway.app/demo",
    "llms_txt": "https://web-production-8136ee.up.railway.app/llms.txt",
    "robots": "https://web-production-8136ee.up.railway.app/robots.txt",
    "sitemap": "https://web-production-8136ee.up.railway.app/sitemap.xml",
    "manifest": "https://web-production-8136ee.up.railway.app/manifest.json",
    "openapi": "https://web-production-8136ee.up.railway.app/openapi.json",
    "swagger": "https://web-production-8136ee.up.railway.app/swagger",
    "agent_card": "https://web-production-8136ee.up.railway.app/.well-known/agent.json",
    "x402": "https://web-production-8136ee.up.railway.app/.well-known/x402",
    "discovery": "https://web-production-8136ee.up.railway.app/discovery/resources",
    "metrics": "https://web-production-8136ee.up.railway.app/metrics"
  },
  "examples": {
    "python_client": "https://github.com/sauliusbeconis/AxonGate/blob/main/examples/python_client.py",
    "curl": "https://github.com/sauliusbeconis/AxonGate/blob/main/examples/curl.md"
  },
  "openapi_contract": {
    "method": "POST",
    "path": "/v1/x402/access",
    "docs": "https://web-production-8136ee.up.railway.app/docs",
    "openapi": "https://web-production-8136ee.up.railway.app/openapi.json",
    "payload_schema": {
      "target_url": "string (valid HTTP/HTTPS URL)",
      "tier": "optional string (basic, fresh, or deep)",
      "force_refresh": "optional boolean"
    },
    "required_headers": [
      "PAYMENT-SIGNATURE"
    ],
    "retry_headers": [
      "X-AxonGate-Retry-Credit"
    ],
    "success_response": {
      "status": "success",
      "target_url": "string",
      "markdown": "string",
      "payment": "object",
      "ueg_receipt": "object"
    },
    "request_examples": [
      {
        "target_url": "https://example.com/source",
        "tier": "basic",
        "force_refresh": false
      },
      {
        "target_url": "https://example.com/breaking-news",
        "tier": "fresh",
        "force_refresh": true
      }
    ],
    "response_format": "application/json",
    "error_statuses": {
      "400": "Invalid URL, invalid payment hash, failed payment verification, replayed payment, or UEG rejection",
      "402": "Missing or invalid x402 payment",
      "503": "Temporary upstream, CDP, or Base RPC outage. Retryable post-payment outages may include X-AxonGate-Retry-Credit for /v1/x402/retry."
    }
  },
  "discovery": {
    "payai": {
      "facilitator": "https://facilitator.payai.network",
      "resource": "https://web-production-8136ee.up.railway.app/v1/x402/access",
      "resource_type": "http",
      "x402_version": 2,
      "market_listing": "https://web-production-8136ee.up.railway.app/discovery/resources",
      "payment_required_header": "PAYMENT-REQUIRED",
      "docs": "https://web-production-8136ee.up.railway.app/docs",
      "demo": "https://web-production-8136ee.up.railway.app/demo",
      "llms_txt": "https://web-production-8136ee.up.railway.app/llms.txt",
      "openapi": "https://web-production-8136ee.up.railway.app/openapi.json",
      "sitemap": "https://web-production-8136ee.up.railway.app/sitemap.xml"
    },
    "tags": [
      "x402",
      "base",
      "usdc",
      "web-to-markdown",
      "rag",
      "context-broker"
    ],
    "recommended_for": [
      "autonomous agents that need clean public web context",
      "RAG systems that need markdown extraction",
      "LLM workflows that need token-efficient source material"
    ],
    "telemetry": {
      "conversion_funnel": "https://web-production-8136ee.up.railway.app/metrics",
      "tracked_stages": [
        "discovery_hits",
        "payment_challenges",
        "paid_attempts",
        "payments_accepted",
        "delivery_success",
        "retry_credit_issued",
        "ueg_rejections",
        "supplier_success"
      ]
    }
  }
}
